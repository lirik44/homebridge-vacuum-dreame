{
  "name": "homebridge-vacuum-dreame",
  "displayName": "Dreame Vacuum",
  "version": "0.1.0",
  "description": "Homebridge plugin exposing Dreame robot vacuums as Matter robotic vacuum cleaners over the local miIO/MIoT protocol",
  "author": "https://github.com/lirik44",
  "homepage": "https://github.com/lirik44/homebridge-vacuum-dreame/blob/main/README.md",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": "^22 || ^24 || ^26",
    "homebridge": "^2.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lirik44/homebridge-vacuum-dreame.git"
  },
  "bugs": {
    "url": "https://github.com/lirik44/homebridge-vacuum-dreame/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "matter",
    "dreame",
    "xiaomi",
    "miot",
    "miio",
    "vacuum",
    "robot-vacuum",
    "robot-vacuum-cleaner",
    "rvc",
    "homekit",
    "apple-home",
    "smarthome"
  ],
  "files": [
    "dist",
    "config.schema.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "buildProduction": "tsc --project tsconfig.production.json",
    "cleanBuild": "npx shx rm -rf tsconfig.tsbuildinfo dist && npm run build",
    "watch": "tsc --watch",
    "test": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --verbose --coverage",
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --fix --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "runMeBeforePublish": "npm run lint && npm run format:check && npm run test && npm run buildProduction",
    "prepublishOnly": "npm run runMeBeforePublish"
  },
  "dependencies": {
    "node-miio": "^0.3.0-beta.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@jest/globals": "30.4.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.16.1",
    "eslint-plugin-jsdoc": "63.3.3",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "homebridge": "^2.4.0",
    "jest": "30.4.2",
    "prettier": "3.9.6",
    "shx": "0.4.0",
    "ts-jest": "29.4.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.67.0"
  }
}
