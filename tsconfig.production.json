{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "declarationMap": false,
    "sourceMap": false,
    "removeComments": true
  },
  "include": ["src/**/*.ts", "types/*.d.ts"],
  "exclude": ["**/*.spec.ts", "**/*.test.ts", "**/*.mock.ts", "**/*.mocks.ts", "**/__test__/*"]
}
